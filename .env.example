GA_ID=G-XXXXXXXXXX
ADSENSE_PUBLISHER_ID=ca-pub-xxxxxxxx
POSTGRES_PASSWORD=change-me
DEBUG=False

APP_ENVIRONMENT=production
APP_REDIS_URL=redis://redis:6379/0
APP_DATABASE_URL=postgresql://app:change-me@pgbouncer:5432/calculator
APP_LOG_FORMAT=json
APP_ALLOWED_ORIGINS=["https://calculator.app","https://time.calculator.app","https://seo.calculator.app"]
APP_RATE_LIMIT_REQUESTS=120
APP_RATE_LIMIT_WINDOW_SECONDS=60

# Frontend (Vite): use the same GA4 Web stream measurement ID on all three domains.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Configure domain-specific AdSense client/slot variables in each deployment.
VITE_ADSENSE_MODE=test
# Set VITE_ADSENSE_MODE=production only after AdSense approves each domain.
VITE_ADSENSE_CALCULATORS_CLIENT=ca-pub-xxxxxxxx
VITE_ADSENSE_CALCULATORS_LEADERBOARD=0000000001
VITE_ADSENSE_CALCULATORS_SIDEBAR=0000000002
VITE_ADSENSE_CALCULATORS_RESULTS=0000000003
VITE_ADSENSE_TIME_CLIENT=ca-pub-xxxxxxxx
VITE_ADSENSE_TIME_LEADERBOARD=0000000011
VITE_ADSENSE_TIME_SIDEBAR=0000000012
VITE_ADSENSE_TIME_RESULTS=0000000013
VITE_ADSENSE_SEO_CLIENT=ca-pub-xxxxxxxx
VITE_ADSENSE_SEO_LEADERBOARD=0000000021
VITE_ADSENSE_SEO_SIDEBAR=0000000022
VITE_ADSENSE_SEO_RESULTS=0000000023
