resource "aws_elasticache_subnet_group" "main" { name = local.name; subnet_ids = var.private_subnet_ids }
resource "aws_elasticache_replication_group" "main" { replication_group_id = "${local.name}-redis"; description = "Kalko Redis cache"; engine = "redis"; engine_version = "7.0"; node_type = "cache.t3.micro"; num_cache_clusters = 1; port = 6379; subnet_group_name = aws_elasticache_subnet_group.main.name; security_group_ids = [aws_security_group.data.id]; snapshot_retention_limit = 1; at_rest_encryption_enabled = true; transit_encryption_enabled = true }
